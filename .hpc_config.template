# HPC Configuration Template
# Copy to .hpc_config and fill in values for your cluster.
# This file is gitignored and will never be committed.
# Usage: source .hpc_config  (from the repo root)

# ============================================================================
# Login
# ============================================================================
export HPC_USERNAME=your_username
export HPC_LOGIN_HOST=login.hpc.example.edu
export HPC_PROJECT=/path/to/your/project   # e.g. /gpfs/cluster/proj/mygroup/myname

# ============================================================================
# Container image
# Store the .sqsh on a shared filesystem (GPFS / Lustre) so every compute
# node can read it without re-pulling. See README for build instructions.
# ============================================================================
export CONTAINER_IMAGE=$HPC_PROJECT/qfm-hpc-py312-v3.sqsh

# ============================================================================
# Slurm
# ============================================================================
export SLURM_PARTITION=gpu           # partition that has GPUs
export SLURM_ACCOUNT=your_account    # leave blank if your cluster doesn't require it

# ============================================================================
# QRMI credentials file (on the shared filesystem, never committed to git)
# See examples/hpc_sqd_demo/README.md § "QRMI credentials" for the format.
# ============================================================================
export QRMI_CREDS=$HPC_PROJECT/.qrmi_config
