# Exclude large binary artifacts from the build context.
# These are not needed inside the container image.
*.tar
*.sqsh
*.log

# Python bytecode
__pycache__/
*.pyc
*.pyo
.pytest_cache/
htmlcov/
.coverage

# Dev / editor
.git/
.github/
*.egg-info/
dist/
build/
.venv/
.env

# Local config (never bake into image)
.hpc_config
push_v4.sh
hpc-ewf-sqd-demo-plan.md

# HPC demo data/results directories — large and not needed inside the image
examples/hpc_demos/*/data/
examples/hpc_demos/*/results/
examples/hpc_demos/*/circuits/
