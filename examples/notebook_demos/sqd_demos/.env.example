# QRMI credentials for sqd_demos notebooks.
#
# Copy this file to .env and fill in your IBM Quantum API key and CRN.
# .env is gitignored — it will never be committed.
#
# The prefix (e.g. ibm_kingston_) must be LOWERCASE and must match
# the QRMI_JOB_QPU_RESOURCES value exactly.
#
# Find your credentials at: https://quantum.ibm.com/account

ibm_kingston_QRMI_IBM_QCS_IAM_APIKEY=<your-iam-api-key>
ibm_kingston_QRMI_IBM_QCS_SERVICE_CRN=<your-crn>

# If using a different backend, add another block with the correct prefix, e.g.:
# ibm_torino_QRMI_IBM_QCS_IAM_APIKEY=<your-iam-api-key>
# ibm_torino_QRMI_IBM_QCS_SERVICE_CRN=<your-crn>
