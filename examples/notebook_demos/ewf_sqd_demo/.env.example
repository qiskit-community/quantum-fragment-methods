# QRMI credentials for the glycine EWF+SQD notebook demo
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is gitignored — your credentials will never be committed.
# Do NOT add real credentials to this .env.example file.
#
# --- How to get these values ---
# IAM API key : https://quantum.ibm.com/account  → "API keys" → "Create key"
# Service CRN : https://quantum.ibm.com/account  → "Instances" → copy the CRN
#               Format: crn:v1:bluemix:public:quantum-computing:REGION:a/ACCOUNT:SERVICE_ID::
#
# NOTE: The backend name prefix must be lowercase and match QRMI_JOB_QPU_RESOURCES exactly.
#       e.g. if QRMI_JOB_QPU_RESOURCES=ibm_pittsburgh, the prefix is ibm_pittsburgh_
#
# --- Endpoint URLs (leave as-is for standard IBM Quantum Cloud) ---
ibm_pittsburgh_QRMI_IBM_QCS_ENDPOINT=https://quantum.cloud.ibm.com/api/v1
ibm_pittsburgh_QRMI_IBM_QCS_IAM_ENDPOINT=https://iam.cloud.ibm.com
#
# --- Fill these in ---
ibm_pittsburgh_QRMI_IBM_QCS_IAM_APIKEY=<your-iam-api-key>
ibm_pittsburgh_QRMI_IBM_QCS_SERVICE_CRN=<your-crn>
#
# --- Backend / resource selection (matches QRMI_JOB_QPU_RESOURCES) ---
# Leave as-is unless you want to target a different backend.
# On SCC/Slurm, this variable is injected automatically by the SPANK plugin.
QRMI_JOB_QPU_RESOURCES=ibm_pittsburgh
QRMI_JOB_QPU_TYPES=ibm-quantum-compute-service
